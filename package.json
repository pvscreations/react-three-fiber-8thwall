{
  "name": "react-three-fiber-8thwall",
  "version": "0.1.0",
  "description": "Starter and package to run React Three Fiber on 8th Wall with one shared WebGLRenderer.",
  "license": "MIT",
  "author": "Nagendra Dharmireddi",
  "type": "module",
  "sideEffects": ["./dist/setup.js"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "build:lib": "tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm run build:lib",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "npx prettier . --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nagendra-dharmireddi0/react-three-fiber-8thwall.git"
  },
  "bugs": {
    "url": "https://github.com/nagendra-dharmireddi0/react-three-fiber-8thwall/issues"
  },
  "homepage": "https://github.com/nagendra-dharmireddi0/react-three-fiber-8thwall#readme",
  "keywords": [
    "react-three-fiber",
    "r3f",
    "three",
    "8thwall",
    "web-ar",
    "ar",
    "xr8"
  ],
  "peerDependencies": {
    "@react-three/fiber": ">=8",
    "react": ">=18",
    "react-dom": ">=18",
    "three": ">=0.150"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-three/fiber": "^9.8.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "3.9.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
